APP_ENV=dev
ZONE_ID=1

MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DB=game_zone_1

REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_USER=
REDIS_PASSWORD=
REDIS_DB=1

LISTEN_HOST=0.0.0.0
LISTEN_PORT=10001
TICK_RATE=30

# 精霊のレベル上限。変更後に POST /api/reload-config を呼べば再起動なしで反映される。
MAX_UNIT_LEVEL=60

# 内部 API 用のトークン。ローカル開発用のサンプル値なので、本番環境では必ずランダムな値に置き換えること。
ZONE_INTERNAL_API_TOKEN=change-me

# チケット復号用の鍵（AES-256-GCM、64 文字の 16 進数 × 4 スロット）。
# APP_ENV=dev で未設定の場合は、gateway の開発用デフォルト鍵が使われる。
# 本番環境では gateway と同じ鍵を 4 つすべて設定すること（鍵はリポジトリにコミットしない）。
# TICKET_AES256_GCM_V1_SLOT1_KEY_HEX=
# TICKET_AES256_GCM_V1_SLOT2_KEY_HEX=
# TICKET_AES256_GCM_V1_SLOT3_KEY_HEX=
# TICKET_AES256_GCM_V1_SLOT4_KEY_HEX=

LOG_LEVEL=debug
